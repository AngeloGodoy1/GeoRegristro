<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo azul oscuro base -->
    <item>
        <color android:color="#00122A" />
    </item>

    <!-- Imagen del Planeta Tierra centrada -->
    <item>
        <bitmap
            android:src="@drawable/tierra"
            android:gravity="center"
            android:tileMode="disabled" />
    </item>

    <!-- Capa de difuminado/oscurecimiento al 60% (#99 = 60% opacidad en hex) -->
    <item>
        <color android:color="#9900122A" />
    </item>
</layer-list>
