<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fondo con escala proporcional centerCrop (sin estirar) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/tierra"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <!-- Capa de difuminado/oscurecido al 60% -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#9900122A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panel Principal"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="40dp" />

        <Button
            android:id="@+id/btnRegistrarIncidencia"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Registrar Nueva Incidencia"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnVerHistorial"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Historial de Incidencias"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnVerMapa"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Ver en Mapa"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Cerrar Sesión"
            android:textColor="#FFFFFF"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>
</FrameLayout>
