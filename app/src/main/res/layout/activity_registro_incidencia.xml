<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fondo con escala proporcional centerCrop (sin estirar) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/tierra"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <!-- Capa de difuminado/oscurecido al 60% -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#9900122A" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registrar Nueva Incidencia"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp" />

            <!-- Fragmento del Mapa para seleccionar la ubicación de la incidencia -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginBottom="12dp">

                <fragment
                    android:id="@+id/mapRegistro"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvCoordenadasRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ubicación GPS: Seleccione en el mapa o pulse Obtener GPS"
                android:textSize="14sp"
                android:textStyle="italic"
                android:textColor="#E0E0E0"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnObtenerUbicacionRegistro"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Mi Ubicación GPS Actual"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Título de la Incidencia"
                android:textColorHint="#CCCCCC"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTituloIncidencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Descripción de la Incidencia"
                android:textColorHint="#CCCCCC"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescripcionIncidencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:lines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnGuardarIncidencia"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Guardar Incidencia"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnVolverMenu"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Volver al Menú Principal"
                android:textColor="#FFFFFF"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
